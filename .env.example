# Supabase public values (safe for browser use when RLS is enabled)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only elevated key. Usually unnecessary for the web application.
# Never expose this as VITE_* or commit a real value.
SUPABASE_SECRET_KEY=

# Public identifiers used by Meta Embedded Signup (not active in this phase)
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
VITE_META_GRAPH_VERSION=v24.0

# Secrets below must only exist in the server/deployment environment
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_TOKEN_ENCRYPTION_KEY=
DATABASE_URL=
OPENAI_API_KEY=

# N8N credentials must remain server-only
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_SIGNING_SECRET=
